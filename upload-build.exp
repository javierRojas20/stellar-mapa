#!/usr/bin/expect -f

set timeout 300
set server_ip "134.209.216.156"
set server_user "root"
set server_pass "17&\\WW#qO53Z"

# Subir archivos del build
spawn scp -r -o StrictHostKeyChecking=no dist/* root@${server_ip}:/var/www/html/

expect {
    "password:" {
        send "${server_pass}\r"
        exp_continue
    }
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    eof
}

wait

# Subir también el directorio assets completo
spawn scp -r -o StrictHostKeyChecking=no dist/assets root@${server_ip}:/var/www/html/

expect {
    "password:" {
        send "${server_pass}\r"
        exp_continue
    }
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    eof
}

wait

# Conectarse y ajustar permisos
spawn ssh -o StrictHostKeyChecking=no root@${server_ip}

expect {
    "password:" {
        send "${server_pass}\r"
    }
    "yes/no" {
        send "yes\r"
        exp_continue
    }
}

expect "# "

# Ajustar permisos
send "chown -R www-data:www-data /var/www/html\r"
expect "# "
send "chmod -R 755 /var/www/html\r"
expect "# "

# Verificar que los archivos están actualizados
send "ls -lh /var/www/html/assets/ | head -5\r"
expect "# "

send "exit\r"
expect eof

